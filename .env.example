# ---------- App ----------
APP_PORT=8080
# Public URL users open (used for secure cookies when https)
PUBLIC_URL=http://localhost:8080
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=300
# Encrypts linked-account tokens at rest (random string). If empty, a key is generated in the data volume.
APP_SECRET=

# ---------- Google single sign-on + YouTube account linking ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized redirect URIs : https://clips.example.com/auth/google/callback
#                              https://clips.example.com/connect/youtube/callback
# Enable "YouTube Data API v3" in the same project (needed to upload Shorts).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
# public | unlisted | private
YOUTUBE_PRIVACY=public

# ---------- TikTok account linking (developers.tiktok.com) ----------
# Products: Login Kit + Content Posting API. Redirect URI: https://clips.example.com/connect/tiktok/callback
# Until TikTok audits your app, direct posts are private (SELF_ONLY); TIKTOK_POST_MODE=inbox sends drafts instead.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_POST_MODE=direct

# ---------- Instagram account linking (developers.facebook.com, "Instagram API with Instagram Login") ----------
# Professional (Business/Creator) Instagram accounts. Redirect URI: https://clips.example.com/connect/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Simulate account linking + uploads (for trying the UI without platform apps)
PUBLISH_DRY_RUN=false

# ---------- Twitch (optional) ----------
# OAuth token of a Twitch Turbo / subscriber account -> no stitched ads in captured video.
TWITCH_AUTH_TOKEN=

# ---------- Auto-update from private GitHub repo ----------
GITHUB_USERNAME=
# Fine-grained PAT with "Contents: Read-only" on the repo
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
GITHUB_BRANCH=main
# Same secret as the GitHub webhook (Settings -> Webhooks -> https://<host>/hooks/github, JSON, push events)
GITHUB_WEBHOOK_SECRET=
# Poll fallback in seconds (0 = webhook only)
UPDATE_POLL_INTERVAL=60
