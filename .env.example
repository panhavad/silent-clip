# ---------- App ----------
APP_PORT=8080
# External Docker network shared with your tunnel / reverse proxy (create it once: docker network create tunnel_net)
TUNNEL_NETWORK=tunnel_net
# Public URL users open (used for secure cookies when https)
PUBLIC_URL=http://localhost:8080
ALLOW_REGISTRATION=true
# New sign-ups need admin approval (first account ever becomes the admin)
REQUIRE_APPROVAL=true
# This email is always an active admin
ADMIN_EMAIL=
# "Run on server" limits: streamers per user / total watchers on this server
MAX_SERVER_STREAMERS=10
MAX_SERVER_WATCHERS=50
MAX_UPLOAD_MB=300

# ---------- Google single sign-on (optional) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized redirect URI : https://clips.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ---------- Posting to YouTube / TikTok / Instagram ----------
# No developer apps or API keys: each user logs in once in Settings -> Social accounts, and a real
# browser on this server posts for them. The Docker image includes Chromium; for `npm run dev`
# an installed Chrome / Edge is found automatically, or point BROWSER_PATH at one.
BROWSER_PATH=
# How many posting browsers may run at once on this server
MAX_PUBLISH_BROWSERS=2
# Simulate posting (logins still open a real browser) for trying the UI safely
PUBLISH_DRY_RUN=false

# ---------- Twitch (optional) ----------
# OAuth token of a Twitch Turbo / subscriber account -> no stitched ads in captured video.
TWITCH_AUTH_TOKEN=
