# ---------- App ----------
APP_PORT=8080
# Public URL users open (used for secure cookies when https)
PUBLIC_URL=http://localhost:8080
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=300

# ---------- Google single sign-on (+ YouTube Shorts upload) ----------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
#   Authorized JavaScript origin : https://clips.example.com
#   Authorized redirect URI      : https://clips.example.com/auth/google/callback
# Enable "YouTube Data API v3" in the same project for one-click Shorts upload.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback
YOUTUBE_UPLOAD=true

# ---------- Twitch (optional) ----------
# OAuth token of a Twitch Turbo / subscriber account -> no stitched ads in captured video.
TWITCH_AUTH_TOKEN=

# ---------- Auto-update from private GitHub repo ----------
GITHUB_USERNAME=
# Fine-grained PAT with "Contents: Read-only" on the repo
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=
GITHUB_BRANCH=main
# Same secret as the GitHub webhook (Settings -> Webhooks -> https://<host>/hooks/github, JSON, push events)
GITHUB_WEBHOOK_SECRET=
# Poll fallback in seconds (0 = webhook only)
UPDATE_POLL_INTERVAL=60
